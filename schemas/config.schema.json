{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "forge_cli_version",
    "memory_file",
    "project_type",
    "test_profiles",
    "guards"
  ],
  "properties": {
    "version": { "type": "string", "const": "2.0" },
    "forge_cli_version": { "type": "string", "minLength": 1 },
    "memory_file": {
      "type": "string",
      "enum": ["CLAUDE.md", "AGENTS.md", "GEMINI.md"]
    },
    "gstack_installed": { "type": "boolean" },
    "gstack_skill_available": {
      "type": "boolean",
      "description": "True when the gstack AI-skill pack is installed at ~/.claude/skills/gstack/. Skill-pack alone does not make verify's gstack steps runnable (no CLI to spawn), but it tells doctor/verify to surface a 'run via AI skill' hint instead of 'missing'."
    },
    "build_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "working_dir"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "working_dir": { "type": "string", "minLength": 1 }
      }
    },
    "test_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "integer", "minimum": 0, "maximum": 100 },
        "integration": { "type": "integer", "minimum": 0, "maximum": 100 },
        "e2e": { "type": "string", "enum": ["P0", "P0+P1", "all"] }
      }
    },
    "project_type": {
      "type": "string",
      "enum": ["new", "existing"]
    },
    "test_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "command", "working_dir"],
        "properties": {
          "framework": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "working_dir": { "type": "string", "minLength": 1 },
          "coverage_command": { "type": "string", "minLength": 1 }
        }
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled", "actions"],
        "properties": {
          "enabled": { "type": "boolean" },
          "every_n_tasks": { "type": "integer", "minimum": 1 },
          "trigger": { "type": "string" },
          "keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "severity_threshold": { "type": "string" },
          "license_allowlist": {
            "type": "array",
            "items": { "type": "string" }
          },
          "budgets": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "actions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gstack_basic": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "security_scan": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "dependency_audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "e2e": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "visual_regression": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" } }
        }
      }
    },
    "context_management": {
      "type": "object",
      "additionalProperties": false,
      "description": "Context management plugin configuration. Controls automatic session handoff and compact suggestions.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Master switch: false disables all context management intervention."
        },
        "threshold_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Context usage percentage above which handoff/compact is advised (0-1)."
        },
        "strategy": {
          "type": "string",
          "enum": ["in-place-restart", "new-window", "prompt-compact", "off"],
          "description": "Preferred context recovery strategy."
        },
        "fallback": {
          "type": "string",
          "enum": ["in-place-restart", "new-window", "prompt-compact", "off"],
          "description": "Fallback strategy when preferred is unavailable."
        },
        "min_tasks_between_handoff": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum tasks completed since last handoff before allowing another (prevents loops)."
        }
      }
    }
  }
}
