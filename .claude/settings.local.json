      "Bash(npm install:*)",
      "Bash(npm view:*)",
      "Bash(npm run *)",
      "Bash(pnpm run *)",
      "Bash(yarn *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(node -e \":*)",
      "Bash(node cli/dist/index.js --log-file /tmp/test-forge.log doctor)",
